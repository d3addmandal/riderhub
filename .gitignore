
# Secrets and build output — never commit these.
.env
.env.local
.env.*.local
frontend/.env
backend/.env
node_modules/
dist/
# TypeScript's incremental build cache. Regenerated by every build, so committing it
# means each deploy dirties the checkout and blocks the next `git pull`.
*.tsbuildinfo
*.log
.firebase/

# Firebase emulator logs
*-debug.log

# Legacy Python prototype
__pycache__/
