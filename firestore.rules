rules_version = '2';

// RiderHub — Firestore security rules.
//
// Deny everything, deliberately.
//
// No client ever talks to Firestore directly: the frontend has no Firestore SDK import,
// and every read and write goes through the Express API, which uses the Admin SDK. The
// Admin SDK bypasses these rules entirely and enforces ownership in route code.
//
// So rules that grant client access protect nothing that is used, and cost real surface.
// The previous version let any signed-in rider read every profile — which, now that
// profiles carry phone numbers, blood groups, medical notes and emergency contacts, was
// a data leak reachable with one line of client SDK. It also let clients write ride
// groups around the API's validation.
//
// Deny-all closes both, and on the free plan it also means a misbehaving or malicious
// client cannot burn the daily read quota straight from the browser.
//
// If a feature ever genuinely needs direct client reads (a live listener, say), open
// exactly that path here with an ownership check — do not reintroduce blanket reads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
