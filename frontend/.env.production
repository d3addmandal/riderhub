# Production build settings. Vite reads this on `npm run build` on top of .env.
#
# On Firebase the API lives on the same origin as the site: Hosting rewrites /api/** to
# the Cloud Function. So the API address is empty — requests go to /api/... on whatever
# domain the rider opened (fly-with-pegasus.web.app or .firebaseapp.com), and there is no
# CORS, no second hostname, no certificate to manage. Leave it empty.
VITE_API_URL=
