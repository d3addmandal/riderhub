# Firebase Console → Project Settings → General → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Your club bot without the @ — run `npm run telegram` to print it.
VITE_TELEGRAM_BOT_USERNAME=

# Google Maps JS API — browser key. Restrict it by HTTP referrer in the Cloud
# console; an unrestricted maps key is how people get billed for other traffic.

# Optional Map ID. Switches Google to vector rendering, which is the only mode that
# supports tilt and heading — i.e. heading-up turn-by-turn navigation. Create one at
# Cloud console → Maps Platform → Map management (JavaScript / Vector).
# A vector map ignores inline styles, so set the dark theme there too.
# Leave blank: navigation still works, just north-up and flat.

VITE_API_URL=http://localhost:3001

# The Google Maps key is NOT here on purpose. It lives in backend/.env and is
# served to the browser at runtime, so it never lands in a downloadable bundle.
