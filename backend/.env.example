# This file is for a DEV MACHINE. The deployed API is a Cloud Function: it needs no
# private key (it runs as its own service account) and reads GOOGLE_MAPS_API_KEY,
# GOOGLE_MAPS_BROWSER_KEY and TELEGRAM_BOT_TOKEN from Cloud Secret Manager — see
# DEPLOY.md step 4. Non-secret production settings live in .env.fly-with-pegasus.

PORT=3001

# ── Firebase Admin ────────────────────────────────────────────
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Easiest path: run `npm run setup` from the project root instead of editing this by hand.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n escapes exactly as in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# No FIREBASE_STORAGE_BUCKET: Cloud Storage requires a paid Blaze plan as of Feb 2026,
# so the documents vault tracks expiry metadata instead of storing files.

# ── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── CORS (dev only) ───────────────────────────────────────────
# In production the API is a Cloud Function behind Firebase Hosting, on the SAME origin
# as the site, so CORS never applies there. Leave unset locally (allow-all).
# FRONTEND_URL=

# ── Routing for live navigation (optional) ────────────────────
# OpenRouteService: 2,500 requests/day free, no credit card.
# Sign up at https://openrouteservice.org/dev/#/signup and paste the key here.
# Leave blank and navigation still works — it draws a direct line instead of roads.

# ── Place search (optional) ───────────────────────────────────
# Google Places (New). Autocomplete keystrokes are free within a session; only the
# terminating Place Details call is billed, and the field mask used keeps it in the
# Essentials SKU (10,000 free/month). Needs billing enabled on the project.
# Leave blank to use Photon (OpenStreetMap) instead — free, no key, weaker in India.
#
# The same key also serves:
#   · Geocoding  — naming a point tapped on the map (Essentials, 10,000 free/month)
#   · Nearby Search — petrol pumps along the route, hotels near a night stop.
#     Searches are anchored every 25 km and capped at 5 anchors per request, then cached
#     for five minutes, so a long ride costs a handful of calls rather than hundreds.
GOOGLE_MAPS_API_KEY=

# ── Rate limiting (optional) ──────────────────────────────────
# Requests per 15 minutes per IP. Leave unset for the sensible defaults (300 general,
# 20 auth). Only worth raising for automated test runs, which hit many endpoints from
# a single address.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Server key: Routes, Places, Geocoding. Never exposed to a browser.
GOOGLE_MAPS_API_KEY=

# Browser key: served by GET /api/config/maps to signed-in riders only.
# Restrict to your domains and to the Maps JavaScript API in the Cloud console.
GOOGLE_MAPS_BROWSER_KEY=

# Optional. A vector Map ID enables tilt and heading for turn-by-turn.
GOOGLE_MAPS_MAP_ID=
